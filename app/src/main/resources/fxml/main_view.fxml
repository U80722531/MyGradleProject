<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<SplitPane dividerPositions="0.65" prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mygradleproject.controller.UserController">
    <items>
        <VBox spacing="10" style="-fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Suchen nach Name/E-Mail..." HBox.hgrow="ALWAYS"/>
                <Button text="Import (CSV)" onAction="#handleImportCSV" styleClass="accent"/>
                <Button text="Export (CSV)" onAction="#handleExportCSV"/>
                <Button text="Report (PDF)" onAction="#handleExportPDF" styleClass="success"/>
            </HBox>
            
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="emailColumn" text="E-Mail" prefWidth="180"/>
                    <TableColumn fx:id="deleteColumn" text="Aktion" prefWidth="100"/>
                </columns>
            </TableView>
            
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="60"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>
                <children>
                    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="nameField" fx:id="nameField" id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="E-Mail:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="emailField" fx:id="emailField" id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </children>
            </GridPane>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="saveButton" id="saveButton" text="Benutzer Speichern" onAction="#handleSaveUser" styleClass="strong"/>
                <Label fx:id="errorLabel" id="errorLabel" style="-fx-text-fill: #ff4d4d;"/>
                <ProgressBar fx:id="progressBar" visible="false" prefWidth="150"/>
            </HBox>
        </VBox>
        
        <VBox spacing="15" style="-fx-padding: 15;" minWidth="300">
            <Label text="📊 Dashboard" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <HBox spacing="15">
                <Label fx:id="totalUsersLabel" id="totalUsersLabel" text="Benutzer gesamt: 0"/>
                <Label fx:id="totalTasksLabel" text="Aufgaben gesamt: 0"/>
            </HBox>
            <PieChart fx:id="taskPieChart" title="Task-Status" prefHeight="200"/>
            <BarChart fx:id="userBarChart" title="Top User Auslastung" prefHeight="220">
                <xAxis><CategoryAxis label="Benutzer"/></xAxis>
                <yAxis><NumberAxis label="Tasks" tickUnit="1" minorTickCount="0"/></yAxis>
            </BarChart>
        </VBox>
    </items>
</SplitPane>
